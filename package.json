{
  "name": "cutie-mark-crusaders",
  "private": true,
  "version": "0.1.0",
  "description": "SDG Open Hack 2026 Challenge 2 prototype",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/web", "services/api"],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev:web --workspace apps/web",
    "dev:api": "npm run dev:api --workspace services/api",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web && npm run lint --workspace services/api",
    "test": "npm run test --workspace services/api"
  }
}
